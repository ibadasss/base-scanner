# ---------------------------------------------------------------------------
# All keys are OPTIONAL. The screener, discovery, and monitor run keyless.
# Copy this file to `.env` and fill in what you want to enable.
# ---------------------------------------------------------------------------

# Telegram alerts for the Smart Money Monitor (`python screener.py --monitor`).
# Setup (2 min):
#   1. Message @BotFather -> /newbot -> copy the token below.
#   2. Send your new bot any message (so it can DM you).
#   3. Get your chat id from @userinfobot, or open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override the Base RPC (else rotates across public endpoints).
BASE_RPC_URL=

# Optional: Etherscan V2 key. NOTE Base (8453) is NOT on Etherscan's free tier,
# so verification uses Sourcify by default. Only useful on a paid plan.
ETHERSCAN_API_KEY=

# Optional: Neynar key for richer Farcaster data (else keyless Warpcast search).
NEYNAR_API_KEY=
